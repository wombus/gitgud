{
  "name": "gitgud",
  "private": true,
  "version": "0.1.0",
  "description": "A first-person junior developer simulator that teaches git one ticket at a time.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "vite build && node scripts/build-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "crosscheck": "tsx scripts/crosscheck.ts",
    "smoke": "vite build && tsx scripts/smoke.ts screenshots",
    "shots": "vite build && tsx scripts/shots.ts screenshots"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "playwright-core": "1.56",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
